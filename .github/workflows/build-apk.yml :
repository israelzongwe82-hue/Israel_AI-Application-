name: Build Israël-ai APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          
      - name: Install Capacitor
        run: |
          npm init -y
          npm install @capacitor/core @capacitor/cli @capacitor/android
          npx cap init Israel-ai com.israelai.app --web-dir=.
          
      - name: Add Android platform
        run: |
          npx cap add android
          npx cap copy android
          
      - name: Copy Icon & Splash to Android
        run: |
          # Copie ton icon.png obligatoire comme icône de l'app
          cp images/icon.png android/app/src/main/res/drawable/ic_launcher.png
          cp images/icon.png android/app/src/main/res/mipmap-hdpi/ic_launcher.png || true
          cp images/icon.png android/app/src/main/res/mipmap-mdpi/ic_launcher.png || true
          cp images/icon.png android/app/src/main/res/mipmap-xhdpi/ic_launcher.png || true
          cp images/icon.png android/app/src/main/res/mipmap-xxhdpi/ic_launcher.png || true
          cp images/icon.png android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png || true
          
          # Copie ton splash.png (même photo ronde) comme splash screen
          cp images/splash.png android/app/src/main/res/drawable/splash.png
          cp images/splash.png android/app/src/main/res/drawable/splash_dark.png || true
          
      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
          
      - name: Build APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug
          
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Israel-ai-APK-avec-icone-officielle
          path: android/app/build/outputs/apk/debug/app-debug.apk
