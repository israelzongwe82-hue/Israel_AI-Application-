name: Générer un APK Android - Israël-AI

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  construire:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Configurer le SDK Android
        run: |
          echo "ANDROID_HOME=$ANDROID_SDK_ROOT" >> $GITHUB_ENV
          echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT" >> $GITHUB_ENV
          echo "$ANDROID_SDK_ROOT/cmdline-tools/latest/bin" >> $GITHUB_PATH
          echo "$ANDROID_SDK_ROOT/platform-tools" >> $GITHUB_PATH
          yes | sdkmanager --licenses || true

      - name: Installer les dépendances
        run: |
          npm install
          npm install @capacitor/core @capacitor/cli @capacitor/android

      - name: Préparer le dossier web
        run: |
          rm -rf www android capacitor.config.json
          mkdir -p www/images
          cp index.html www/
          cp -r images/* www/images/ || cp images/icon.png www/images/ || true
          ls -la www/
          ls -la www/images/

      - name: Initialisation Capacitor
        run: |
          npx cap init "Israël_AI Sept2026" com.israelzongwe82.israelai.sept2026 --web-dir=www

      - name: Ajouter Android
        run: |
          npx cap add android
          npx cap copy android
          npx cap sync android

      - name: Injecter icon et splash REEL
        run: |
          echo "--- Injection icône ---"
          for d in mipmap-hdpi mipmap-mdpi mipmap-xhdpi mipmap-xxhdpi mipmap-xxxhdpi; do
            mkdir -p android/app/src/main/res/$d
            cp www/images/icon.png android/app/src/main/res/$d/ic_launcher.png
            cp www/images/icon.png android/app/src/main/res/$d/ic_launcher_round.png
            cp www/images/icon.png android/app/src/main/res/$d/ic_launcher_foreground.png || true
          done

          echo "--- Injection splash ---"
          mkdir -p android/app/src/main/res/drawable
          mkdir -p android/app/src/main/res/drawable-nodpi
          cp www/images/splash.png android/app/src/main/res/drawable/splash.png
          cp www/images/splash.png android/app/src/main/res/drawable-nodpi/splash.png
          cp www/images/icon.png android/app/src/main/res/drawable/ic_launcher.png

          echo "--- Vérification ---"
          ls -lh android/app/src/main/res/mipmap-xxxhdpi/
          ls -lh android/app/src/main/res/drawable/splash.png

          echo "--- Modification thème splash ---"
          cat > android/app/src/main/res/values/styles.xml << 'EOF'
          <?xml version="1.0" encoding="utf-8"?>
          <resources>
              <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
                  <item name="colorPrimary">#3B82F6</item>
                  <item name="colorPrimaryDark">#2563EB</item>
                  <item name="colorAccent">#7C3AED</item>
              </style>
              <style name="AppTheme.NoActionBar" parent="AppTheme">
                  <item name="windowActionBar">false</item>
                  <item name="windowNoTitle">true</item>
              </style>
              <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
                  <item name="android:background">@drawable/splash</item>
              </style>
          </resources>
          EOF

      - name: CONSTRUCTION
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: Téléverser l'APK
        uses: actions/upload-artifact@v4
        with:
          name: israel-ai-sept2026-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
