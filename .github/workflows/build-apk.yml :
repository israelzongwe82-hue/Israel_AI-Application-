name: Build Israël-ai APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Install Capacitor
        run: |
          npm init -y
          npm install @capacitor/core @capacitor/cli @capacitor/android

      - name: Init and Add Android
        run: |
          npx cap init Israël-ai com.israelai.app --web-dir=.
          npx cap add android
          npx cap copy android

      - name: Copy Icon and Splash
        run: |
          ls -la images/
          # Créer les dossiers si besoin et copier l'icône officielle
          mkdir -p android/app/src/main/res/drawable
          cp images/icon.png android/app/src/main/res/drawable/ic_launcher.png || true
          cp images/splash.png android/app/src/main/res/drawable/splash.png || true
          # Copier aussi dans mipmap si les dossiers existent
          for d in android/app/src/main/res/mipmap-*; do
            if [ -d "$d" ]; then
              cp images/icon.png "$d/ic_launcher.png" || true
              cp images/icon.png "$d/ic_launcher_round.png" || true
            fi
          done

      - name: Build APK
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --info

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Israel-ai-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
